<Project>
  <PropertyGroup>
    <Version>0.1.0-alpha.2</Version>
    <PackageVersion>$(Version)</PackageVersion>
    <AssemblyVersion>0.1.0.0</AssemblyVersion>
    <FileVersion>0.1.0.0</FileVersion>

    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>14.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- Legacy IFileSystem request/result types stay obsolete until WS5-C8. -->
    <WarningsNotAsErrors>$(WarningsNotAsErrors);CS0618</WarningsNotAsErrors>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
    <DebugType>embedded</DebugType>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>

    <Authors>AgentKit contributors</Authors>
    <Company>AgentKit</Company>
    <Product>AgentKit</Product>
    <Copyright>Copyright (c) AgentKit contributors.</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/pavkam/agent-framework</PackageProjectUrl>
    <RepositoryUrl>https://github.com/pavkam/agent-framework.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <!-- GenerateDocumentationFile stays true for every project, including
       test and executable projects: Roslyn's IDE0005 (remove unnecessary
       usings) analyzer requires documentation-comment parsing to run during
       build and fails the build outright if GenerateDocumentationFile is
       false while IDE0005 is enabled (see
       https://github.com/dotnet/roslyn/issues/41640). Test/executable
       projects instead suppress CS1591 (missing XML comment) in
       Directory.Build.targets, once IsTestProject/OutputType are known. -->
</Project>
