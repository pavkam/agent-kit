{
    "overrides": [
        {
            "files": "*.{md,yml,yaml,json,jsonc}",
            "options": {
                "printWidth": 80,
                "proseWrap": "always",
                "tabWidth": 2,
                "useTabs": false,
                "singleQuote": false,
                "embeddedLanguageFormatting": "auto"
            }
        }
    ]
}
