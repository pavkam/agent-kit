    <IsPackable>true</IsPackable>
    <DebugType>portable</DebugType>
    <PackageId>AgentKit.Abstractions</PackageId>
    <Title>AgentKit Abstractions</Title>
    <Description>Provider-neutral contracts for composing agentic applications on .NET.</Description>
    <PackageTags>agents;ai;llm;abstractions;dependency-injection</PackageTags>
