<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <PackageId>AgentKit.Durability.Sqlite</PackageId>
    <Title>AgentKit.Durability.Sqlite</Title>
    <Description>Durable host-local SQLite operation-journal and execution-lease storage for AgentKit.</Description>
    <PackageTags>agents;ai;durability;storage;sqlite</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../AgentKit.Abstractions/AgentKit.Abstractions.csproj" />
    <ProjectReference Include="../AgentKit.Observability/AgentKit.Observability.csproj" />
    <ProjectReference Include="../AgentKit.Storage.Json/AgentKit.Storage.Json.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="../AgentKit.Durability.Storage.Shared/*.cs" Link="Storage/%(Filename)%(Extension)" />
  </ItemGroup>
  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="/" />
  </ItemGroup>
</Project>
