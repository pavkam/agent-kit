<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <DebugType>portable</DebugType>
    <PackageId>AgentKit.Tools.FileSystem</PackageId>
    <Title>AgentKit.Tools.FileSystem</Title>
    <Description>Read and write file tools for AgentKit, built on the IFileSystem host-access abstraction.</Description>
    <PackageTags>agents;ai;llm;tools;file-system;dependency-injection</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions"/>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../AgentKit.Tools/AgentKit.Tools.csproj"/>
  </ItemGroup>

  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="/" Link="README.md"/>
  </ItemGroup>
</Project>
