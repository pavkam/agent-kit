<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <DebugType>portable</DebugType>
    <PackageId>AgentKit.Context.Retrieval</PackageId>
    <Title>AgentKit.Context.Retrieval</Title>
    <Description>Retrieval-backed context contribution for AgentKit: authorized, provenance-carrying candidates as untrusted reference data.</Description>
    <PackageTags>agents;ai;llm;context;retrieval;memory;dependency-injection</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions"/>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions"/>
    <PackageReference Include="Microsoft.Extensions.Options"/>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../AgentKit.Abstractions/AgentKit.Abstractions.csproj"/>
    <ProjectReference Include="../AgentKit.Context/AgentKit.Context.csproj"/>
    <ProjectReference Include="../AgentKit.Observability/AgentKit.Observability.csproj"/>
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="/"/>
  </ItemGroup>
</Project>
