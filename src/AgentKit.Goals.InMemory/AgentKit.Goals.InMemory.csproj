<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <PackageId>AgentKit.Goals.InMemory</PackageId>
    <Title>AgentKit.Goals.InMemory</Title>
    <Description>Explicitly ephemeral process-local goal storage for AgentKit.</Description>
    <PackageTags>agents;ai;goals;delegation;storage;in-memory</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../AgentKit.Abstractions/AgentKit.Abstractions.csproj" />
    <ProjectReference Include="../AgentKit.Observability/AgentKit.Observability.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="../AgentKit.Goals.Storage.Shared/*.cs" Link="Storage/%(Filename)%(Extension)" />
  </ItemGroup>
  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="/" />
  </ItemGroup>
</Project>
