<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <DebugType>portable</DebugType>
    <PackageId>AgentKit.Providers.GoogleVertexAI</PackageId>
    <Title>AgentKit Providers Google Vertex AI</Title>
    <Description>Google Cloud Vertex AI generateContent conversational provider integration for AgentKit, with Google Cloud OAuth/Application Default Credentials support.</Description>
    <PackageTags>agents;ai;llm;google;vertex;gcp;providers</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions"/>
    <PackageReference Include="Microsoft.Extensions.Options"/>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../AgentKit.Abstractions/AgentKit.Abstractions.csproj"/>
    <ProjectReference Include="../AgentKit.Providers.GoogleGemini/AgentKit.Providers.GoogleGemini.csproj"/>
  </ItemGroup>

  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="/" Link="README.md"/>
  </ItemGroup>
</Project>
