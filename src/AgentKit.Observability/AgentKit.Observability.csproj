<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <DebugType>portable</DebugType>
    <PackageId>AgentKit.Observability</PackageId>
    <Title>AgentKit Observability</Title>
    <Description>Shared Microsoft logging, tracing, and metrics conventions for AgentKit.</Description>
    <PackageTags>agents;ai;llm;observability;logging;diagnostics</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions"/>
    <PackageReference Include="Microsoft.Extensions.Logging"/>
  </ItemGroup>

  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="/" Link="README.md"/>
  </ItemGroup>
</Project>
