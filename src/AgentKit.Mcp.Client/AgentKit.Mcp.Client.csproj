<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <DebugType>portable</DebugType>
    <PackageId>AgentKit.Mcp.Client</PackageId>
    <Title>AgentKit.Mcp.Client</Title>
    <Description>Reflection-driven, typed MCP client tool surfaces for AgentKit.</Description>
    <PackageTags>agents;ai;llm;mcp;client;json-rpc;reflection</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
