  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../AgentKit.Mcp/AgentKit.Mcp.csproj"/>
    <ProjectReference Include="../AgentKit.Observability/AgentKit.Observability.csproj"/>
  </ItemGroup>

  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="/" Link="README.md"/>
  </ItemGroup>
</Project>
