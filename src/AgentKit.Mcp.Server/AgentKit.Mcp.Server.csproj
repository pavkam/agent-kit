<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <DebugType>portable</DebugType>
    <PackageId>AgentKit.Mcp.Server</PackageId>
    <Title>AgentKit.Mcp.Server</Title>
    <Description>Reflection-driven MCP server tool exposure for AgentKit.</Description>
    <PackageTags>agents;ai;llm;mcp;server;json-rpc;reflection</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions"/>
    <PackageReference Include="ModelContextProtocol"/>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../AgentKit.Mcp/AgentKit.Mcp.csproj"/>
  </ItemGroup>

  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="/" Link="README.md"/>
  </ItemGroup>
</Project>
