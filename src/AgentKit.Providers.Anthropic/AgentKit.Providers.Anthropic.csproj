<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <DebugType>portable</DebugType>
    <PackageId>AgentKit.Providers.Anthropic</PackageId>
    <Title>AgentKit Providers Anthropic</Title>
    <Description>Anthropic Claude Messages conversational provider integration for AgentKit, with API key and OAuth credential support.</Description>
    <PackageTags>agents;ai;llm;anthropic;claude;providers</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions"/>
    <PackageReference Include="Microsoft.Extensions.Options"/>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../AgentKit.Abstractions/AgentKit.Abstractions.csproj"/>
    <ProjectReference Include="../AgentKit.Providers/AgentKit.Providers.csproj"/>
  </ItemGroup>

  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="/" Link="README.md"/>
  </ItemGroup>
</Project>
