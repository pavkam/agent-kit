<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <PackageId>AgentKit.Budgets.Sqlite</PackageId>
    <Title>AgentKit.Budgets.Sqlite</Title>
    <Description>Durable host-local SQLite budget-ledger storage for AgentKit.</Description>
    <PackageTags>agents;ai;budgets;storage;sqlite</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="../AgentKit.Budgets.Storage.Shared/*.cs" Link="Storage/%(Filename)%(Extension)" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../AgentKit.Abstractions/AgentKit.Abstractions.csproj" />
    <ProjectReference Include="../AgentKit.Observability/AgentKit.Observability.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="/" />
  </ItemGroup>
</Project>
