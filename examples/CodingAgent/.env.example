# Copy this file to .env.local (already gitignored) and fill in your own key.
# .env.local is loaded automatically at startup and never overrides a variable
# already exported in your shell.

OPENAI_API_KEY=sk-...

# Optional: select the initial Terra, Sol, or Astra model.
# CODING_AGENT_MODEL=gpt-5.6-terra

# Optional absolute SQLite path for durable conversation sessions.
# Defaults beneath platform-local application data in a workspace-keyed directory.
# CODING_AGENT_SESSION_DB=/absolute/path/to/coding-agent-sessions.db

# Optional absolute read-only toolchain roots, separated by the platform PATH separator.
# CODING_AGENT_TOOLCHAIN_ROOTS=/opt/homebrew

# Exact PATH projected into sandboxed commands. Ambient PATH is never inherited.
# CODING_AGENT_COMMAND_PATH=/opt/homebrew/opt/python@3.14/bin:/opt/homebrew/bin:/usr/bin:/bin
