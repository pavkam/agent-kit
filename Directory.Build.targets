<Project>
  <!-- Test and executable projects keep GenerateDocumentationFile=true
       (required for IDE0005 to run at all; see Directory.Build.props) but
       do not ship a public API surface worth documenting, so CS1591
       (missing XML comment) is suppressed here instead. This condition is
       evaluated after the project body sets IsTestProject/OutputType,
       because Directory.Build.targets is imported after it. -->
  <PropertyGroup Condition="'$(IsTestProject)' == 'true' Or '$(OutputType)' == 'Exe'">
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <PropertyGroup Condition="'$(IsTestProject)' == 'true'">
    <!-- Test names intentionally use MethodName_WhenThis_ThatIsExpected
         (CA1707 covers the underscores; IDE1006 would otherwise also
         require every async test method to additionally end in "Async",
         which conflicts with that mandated pattern). -->
    <NoWarn>$(NoWarn);CA1707;IDE1006</NoWarn>
  </PropertyGroup>

  <Target Name="ValidateNuGetPackageMetadata"
          BeforeTargets="GenerateNuspec"
          Condition="'$(IsPackable)' == 'true'">
    <ItemGroup>
      <_RequiredNuGetMetadata Include="PackageId" Value="$(PackageId)"/>
      <_RequiredNuGetMetadata Include="PackageVersion" Value="$(PackageVersion)"/>
      <_RequiredNuGetMetadata Include="Title" Value="$(Title)"/>
      <_RequiredNuGetMetadata Include="Authors" Value="$(Authors)"/>
      <_RequiredNuGetMetadata Include="Description" Value="$(Description)"/>
      <_RequiredNuGetMetadata Include="PackageTags" Value="$(PackageTags)"/>
      <_RequiredNuGetMetadata Include="PackageLicenseExpression" Value="$(PackageLicenseExpression)"/>
      <_RequiredNuGetMetadata Include="PackageProjectUrl" Value="$(PackageProjectUrl)"/>
      <_RequiredNuGetMetadata Include="RepositoryUrl" Value="$(RepositoryUrl)"/>
      <_RequiredNuGetMetadata Include="RepositoryType" Value="$(RepositoryType)"/>
      <_RequiredNuGetMetadata Include="PackageReadmeFile" Value="$(PackageReadmeFile)"/>
      <_RequiredNuGetMetadata Include="Copyright" Value="$(Copyright)"/>
    </ItemGroup>

    <Error Condition="'%(_RequiredNuGetMetadata.Value)' == ''"
           Text="NuGet package metadata '%(_RequiredNuGetMetadata.Identity)' must be set for $(MSBuildProjectName)."/>
  </Target>
</Project>
